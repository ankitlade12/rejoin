# Copy to .env; never commit real credentials.
REJOIN_HOST_PASSWORD=replace-with-a-long-random-password
PORT=4173
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:4173
# Optional AI tutoring. Without a key, authored hints remain available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
REJOIN_AI_CALL_LIMIT=40
# Broadcaster-owned user token, scope user:read:chat.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
# Required only for optional learner OAuth linking.
# Register redirect: http://localhost:4173/auth/twitch/callback
TWITCH_CLIENT_SECRET=
